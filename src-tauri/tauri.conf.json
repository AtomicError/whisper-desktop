{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperDesktop",
  "version": "3.0.0",
  "identifier": "com.whisper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Whisper Desktop",
        "width": 1024,
        "height": 768,
        "maximized": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": [7, 9, 19, 255]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/whisper-cli-*",
      "resources/ffmpeg*",
      "resources/ffprobe*",
      "resources/fonts/*"
    ],

    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./desktop.desktop"
      },
      "rpm": {
        "desktopTemplate": "./desktop.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
