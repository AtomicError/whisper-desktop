{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisper Desktop",
  "version": "2.0.0",
  "identifier": "com.whisper.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Whisper Desktop",
        "width": 1024,
        "height": 768,
        "maximized": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "resources": [
      "resources/whisper-cli-standard",
      "resources/whisper-cli-vulkan",
      "resources/whisper-cli-openvino",
      "resources/whisper-cli-cuda"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./desktop.desktop"
      },
      "rpm": {
        "desktopTemplate": "./desktop.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/lib/x86_64-linux-gnu/libicudata.so.74": "/usr/lib/x86_64-linux-gnu/libicudata.so.74",
          "/usr/lib/x86_64-linux-gnu/libicuuc.so.74": "/usr/lib/x86_64-linux-gnu/libicuuc.so.74",
          "/usr/lib/x86_64-linux-gnu/libicui18n.so.74": "/usr/lib/x86_64-linux-gnu/libicui18n.so.74"
        }
      }
    }
  }
}
