# ==========================================
#          Whisper Desktop Gitignore
# ==========================================

# --- Node & Frontend ---
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Rust & Cargo ---
**/target/
**/*.rs.bk
Cargo.lock.log

# --- Tauri v2 Specifics ---
src-tauri/gen/
src-tauri/build.log

# --- Arch Linux Packaging Artifacts ---
pkg/
*.pkg.tar.zst
*.pkg.tar.xz

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo

# --- IDEs & Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
.zcode/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Temporary Subtitles & Diagnostic Logs ---
debug_subtitles.ass
*.temp.ass
debug_error.log
debug_rust.log

# --- Local & Bundled Standalone Media Binaries ---
src-tauri/resources/ffmpeg*
src-tauri/resources/ffprobe*

# --- Local Compiled Whisper Engines & Shared Libraries (Dev Testing Only) ---
src-tauri/resources/standard/*
!src-tauri/resources/standard/.keep
src-tauri/resources/vulkan/*
!src-tauri/resources/vulkan/.keep
src-tauri/resources/openvino/*
!src-tauri/resources/openvino/.keep
src-tauri/resources/cuda/*
!src-tauri/resources/cuda/.keep
src-tauri/resources/*.so
src-tauri/resources/*.so.*
!src-tauri/resources/placeholder.so

# --- Local AI & Agent Guidelines ---
AGENTS.md
